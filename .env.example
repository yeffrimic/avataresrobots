# Copia este archivo como .env y pega tu clave de https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_clave_aqui
PORT=3000

# --- Modo cajero de máquina expendedora (opcional, ver cajero/README.md) ---
# Si defines CAJERO_URL, el avatar se convierte en el cajero de la máquina.
# CAJERO_URL=http://localhost:4000
# Dirección de tu programa de inventario (la API que se describe en cajero/API.md)
# INVENTARIO_URL=http://localhost:4100
# Opcional: token que el cajero le envía a tu programa (Authorization: Bearer ...)
# INVENTARIO_TOKEN=
# Opcional: token que tu programa debe enviar al avisarle al cajero (header X-Cajero-Token)
# CAJERO_TOKEN=
